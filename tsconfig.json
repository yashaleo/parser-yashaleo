{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": false,
    "types": ["node", "jest", "puppeteer"],
    "isolatedModules": true,
    "baseUrl": "./src",                        // Enables cleaner relative imports
    "paths": {
      "*": ["*", "./*"]
    }
  },
  "include": ["src/**/*", "src/types"],
  "exclude": ["node_modules", ".build"]
}