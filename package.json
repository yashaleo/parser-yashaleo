{
  "name": "parser-yashaleo",
  "version": "1.0.0",
  "description": "Self-hosted Postlight Parser API for n8n scraping",
  "license": "MIT",
  "main": "src/handler.ts",
  "scripts": {
    "build": "node_modules/.bin/serverless webpack",
    "start": "node_modules/.bin/serverless offline start",
    "dev": "nodemon --exec serverless offline start",
    "test": "jest",
    "lint": "eslint ./src --fix",
    "deploy": "cross-env NODE_ENV=dev yarn deploy:env",
    "deploy:env": "cross-env-shell serverless deploy --stage $NODE_ENV",
    "deploy:prod": "cross-env NODE_ENV=prod yarn deploy:env",
    "deploy:stage": "cross-env NODE_ENV=stage yarn deploy:env"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@postlight/parser": "^2.2.2",
    "@types/aws-lambda": "^8.10.120",
    "serverless": "^4.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/jest": "^29.5.11",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "serverless-offline": "^13.2.0",
    "serverless-webpack": "^5.10.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.3",
    "webpack": "^5.91.0",
    "webpack-node-externals": "^3.0.0"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
