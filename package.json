{
  "name": "modern-web-parser-api",
  "version": "1.0.0",
  "description": "Modern web content parser API for extracting clean content from websites",
  "type": "module",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node --experimental-specifier-resolution=node dist/server.js",
    "start:gc": "node --expose-gc dist/server.js",
    "dev": "nodemon --exec ts-node-esm src/server.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --coverage",
    "test:parse": "jest test/services/parser.test.ts",
    "test:html": "jest test/handlers/parse-html.test.ts",
    "test:integration": "jest --testMatch='**/test/integration/**/*.test.ts'",
    "lint": "eslint ./src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install",
    "deploy": "cross-env NODE_ENV=production yarn build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "aws-lambda": "^1.0.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsdom": "^26.1.0",
    "node-cache": "^5.1.2",
    "node-fetch": "2",
    "openai": "^4.96.2",
    "puppeteer": "^24.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "turndown": "^7.2.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/aws-lambda": "^8.10.149",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsdom": "^21.1.5",
    "@types/node-fetch": "2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/turndown": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "typescript-eslint": "^7.0.0"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "resolutions": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.17.31"
  }
}
